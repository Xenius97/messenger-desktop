{
  "name": "messenger-desktop",
  "version": "1.0.1",
  "main": "dist/main.js",
  "description": "Messenger Desktop",
  "author": "Xenius",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xenius97/messenger-desktop"
  },
  "scripts": {
    "start": "npm run compile && electron .",
    "dev": "tsc -w",
    "compile": "tsc",
    "build": "npm run compile && electron-builder",
    "build:installer": "npm run compile && electron-builder --win nsis",
    "build:portable": "npm run compile && electron-builder --win portable",
    "publish": "npm run compile && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^20.19.32",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.messenger.desktop",
    "productName": "Messenger",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!src",
      "!tsconfig.json",
      "!*.ts"
    ],
    "win": {
      "icon": "assets/app.ico"
    },
    "nsis": {
      "artifactName": "Messenger-Setup-v${version}.exe",
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Messenger-Portable-v${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Xenius97",
      "repo": "messenger-desktop",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "electron-updater": "^6.6.2"
  }
}
